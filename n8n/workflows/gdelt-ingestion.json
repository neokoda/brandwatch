{
  "name": "GDELT Ingestion (every 15min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://api.gdeltproject.org/api/v2/doc/doc",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "={{$vars.TRACKER_KEYWORDS}}" },
            { "name": "mode", "value": "artlist" },
            { "name": "maxrecords", "value": "75" },
            { "name": "format", "value": "json" },
            { "name": "timespan", "value": "15min" }
          ]
        }
      },
      "name": "Fetch GDELT Articles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{$vars.API_BASE_URL}}/api/ingest/mentions",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer ={{$vars.API_TOKEN}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ tracker_id: $vars.TRACKER_ID, mentions: $json.articles.map(a => ({ source_channel: 'gdelt', source_url: a.url, source_domain: a.domain, author_name: a.domain, region_code: a.sourcecountry, language_code: a.sourcelang, content_text: a.title + ' ' + (a.seendatetime || ''), keywords_matched: $vars.TRACKER_KEYWORDS.split(','), raw_payload: a })) }) }}"
      },
      "name": "POST to Ingest API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Fetch GDELT Articles", "type": "main", "index": 0 }]]
    },
    "Fetch GDELT Articles": {
      "main": [[{ "node": "POST to Ingest API", "type": "main", "index": 0 }]]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [],
  "meta": {
    "notes": "Set environment variables in n8n: API_BASE_URL (deployed FastAPI URL), API_TOKEN (JWT for service account), TRACKER_ID (UUID), TRACKER_KEYWORDS (comma-separated). One workflow per tracker. Alternatively, APScheduler inside FastAPI runs the same logic as fallback."
  }
}
