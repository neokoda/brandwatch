DATABASE_URL=postgresql+asyncpg://user:pass@host/brandwatch

HUGGINGFACE_API_TOKEN=hf_...
YOUTUBE_API_KEY=AIza...
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=brandwatch/1.0

JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_EXPIRE_MINUTES=1440

# Default anomaly thresholds (overridable per account in DB)
DEFAULT_ALERT_NEGATIVITY_SURGE_Z=2.5
DEFAULT_ALERT_VOLUME_SPIKE_Z=3.0
DEFAULT_ALERT_CRISIS_NEG_SHARE=0.65
INFLUENCER_FOLLOWER_THRESHOLD=10000

CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
