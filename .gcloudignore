# Files excluded from gcloud builds submit upload
# This mirrors .dockerignore but is applied before upload (saves bandwidth)
.git
.gitignore
**/.env
backend/.env

# Frontend build artifacts — not needed in backend image
frontend/node_modules/
frontend/.next/
frontend/out/

# Other
n8n/
docs/
*.md
!backend/requirements.txt
.DS_Store
Thumbs.db
**/__pycache__
**/*.pyc
